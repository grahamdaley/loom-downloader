# Session cookie from https://www.loom.com while you are signed in.
# Chrome/Safari: DevTools → Application → Cookies → https://www.loom.com
# Copy the value of connect.sid (it usually starts with s%3A).
# Paste either that raw value, or the pair connect.sid=<value>.
# The cookie lasts about 30 days. Do not commit the real .env file.
LOOM_COOKIE=

# Directory for downloaded MP4s. Relative paths are resolved from this folder.
LOOM_DOWNLOAD_DIR=downloads
